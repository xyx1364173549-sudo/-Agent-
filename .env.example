# ============================================
# 【这是模板文件，不要在这里填真实密钥！】
#
# 正确步骤：
#   1. 先复制成 .env     →  命令：copy .env.example .env
#   2. 再用编辑器打开 .env，把密钥填进去
#
# 为什么：本文件会提交到 Git（公开可见），而 .env 已在 .gitignore
# 中被排除、不会上传。密钥填错地方 = 泄漏。
# ============================================

# ---------- DeepSeek ----------
# 必填。到 https://platform.deepseek.com 申请后填在这里
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 向量库 / 检索（M3 阶段使用，暂时可不动） ----------
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=text-embedding-3-small

# ---------- FastAPI 服务（M5 阶段使用，暂时可不动） ----------
API_HOST=127.0.0.1
API_PORT=8000

# ---------- 分层记忆数据库（M2 阶段使用，暂时可不动） ----------
MEMORY_DB_PATH=./data/memory.db

# ---------- 日志 ----------
LOG_DIR=./logs

# ---------- 代理（如果你连不上 DeepSeek，取消下面两行注释） ----------
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
